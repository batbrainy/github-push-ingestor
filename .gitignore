# Rails runtime artifacts
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep

# Secrets — the credentials key is never committed
/config/master.key

# Environment files (the committed template is .env.example)
.env
.env.*
!.env.example

# Bundler
/.bundle
/vendor/bundle

# Test artifacts
/coverage/
/spec/reports/
/spec/examples.txt

# AI tooling local state — never part of the submission
/.claude/
