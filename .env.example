# Environment template. `docker compose up --build` works with no .env file —
# every variable below has a working default. Copy to .env only to override.
#
# Variables compose passes through to the app containers:

# Log verbosity: debug | info | warn | error (IMPLEMENTATION_PLAN.md §11).
# DEBUG adds per-request / per-page lines; INFO carries the run summaries.
LOG_LEVEL=info

# Rails environment used by the compose app services (web, setup).
# RAILS_ENV=development

# Connection pool / Puma thread sizing.
# RAILS_MAX_THREADS=5

# Database connection. Inside compose these are managed by the topology
# itself (host `db`, user/password `postgres`) and are NOT .env-overridable;
# they only matter when running the app outside compose.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Budget knobs, fairness shares, refresh TTLs, and GITHUB_MODE arrive with
# PRs 4-7 (plan §10, §13) and will be documented here as they land.
