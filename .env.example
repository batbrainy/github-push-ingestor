# Environment template. `docker compose up --build` works with no .env file —
# every variable below has a working default. Copy to .env only to override.
#
# Variables compose passes through to the app containers:

# Log verbosity: debug | info | warn | error (IMPLEMENTATION_PLAN.md §11).
# DEBUG adds per-request / per-page lines; INFO carries the run summaries.
LOG_LEVEL=info

# Rails environment used by the compose app services (web, setup).
# RAILS_ENV=development

# Connection pool / Puma thread sizing.
# RAILS_MAX_THREADS=5

# Database connection. Inside compose these are managed by the topology
# itself (host `db`, user/password `postgres`) and are NOT .env-overridable;
# they only matter when running the app outside compose.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# GitHub request infrastructure (IMPLEMENTATION_PLAN.md §2A, §6, §10)
# ---------------------------------------------------------------------------

# live    - poll and enrich against https://api.github.com. The default runtime
#           behavior (plan §12).
# fixture - resolve every request inside fixtures/github/, with no network at
#           all. An unknown URL is an error; there is no live fallback (§6).
GITHUB_MODE=live

# Which corpus scenario fixture mode plays. Read only when GITHUB_MODE=fixture;
# see fixtures/github/README.md for the list.
# GITHUB_FIXTURE_SCENARIO=default

# HTTP client timeouts, in seconds (plan §2A).
# HTTP_OPEN_TIMEOUT_SECONDS=5
# HTTP_READ_TIMEOUT_SECONDS=15

# Retries after a 5xx or a network timeout, and redirects followed per request.
# Every retry and every redirect is a fresh budget reservation (§10), so raising
# either raises real GitHub quota consumption.
# MAX_HTTP_RETRIES=2
# MAX_REDIRECTS=2

# How long the one-shot ingestion command waits for a busy source lock (§9).
# The always-on poller attempts once and defers to its next cycle regardless.
# SOURCE_LOCK_WAIT_SECONDS=30

# Inputs to the one authoritative allowance formula (§10):
#
#   poll_attempt_allowance = ceil(3600 / POLL_INTERVAL_SECONDS)
#                            x MAX_PAGES_PER_POLL x ENABLED_LIVE_SOURCE_COUNT
#   enrichment_allowance   = rate_limit - RATE_LIMIT_RESERVE - poll_attempt_allowance
#
# With these defaults: ceil(3600/300) x 1 x 1 = 12 poll attempts/hour, and
# 60 - 8 - 12 = 40 enrichment attempts/hour. Startup fails if
# poll_attempt_allowance + RATE_LIMIT_RESERVE reaches the limit, which would
# leave no capacity for the enrichment Story 3 requires.
#
# POLL_INTERVAL_SECONDS and MAX_PAGES_PER_POLL are consumed by the formula now
# and obeyed by the poller in PR 6.
# POLL_INTERVAL_SECONDS=300
# MAX_PAGES_PER_POLL=1
# ENABLED_LIVE_SOURCE_COUNT=1
# RATE_LIMIT_RESERVE=8

# Deliberately absent, and not oversights:
#
#   GITHUB_API_BASE_URL / GITHUB_API_HOST - the allowed host is a constant in
#     Github::UrlPolicy. An env var there would make the SSRF boundary (§10) a
#     deployment setting.
#   GITHUB_API_VERSION - §2A pins 2022-11-28, the version every live probe behind
#     this plan was run under. Upgrading re-verifies payload shape first; it is
#     not a deploy-time toggle.
#
# Fairness shares and enrichment refresh TTLs arrive with PR 7 (§10).
