#!/usr/bin/env ruby
# The Solid Queue supervisor (IMPLEMENTATION_PLAN.md §2A), the entry point behind the
# `worker` compose service: a dispatcher, a scheduler running config/recurring.yml, and the
# worker threads defined in config/queue.yml.
#
# Generated by `bin/rails generate solid_queue:install` and left as generated. It loads
# config/environment, so config/initializers/github.rb's budget validation runs here too — a
# configuration whose polling requirement leaves no enrichment capacity stops the worker at
# boot rather than letting it poll into an over-commitment (§10).
#
# `bin/jobs check` validates both YAML files without starting a process; CI runs that, and
# then runs this supervisor for real in fixture mode.

require_relative "../config/environment"
require "solid_queue/cli"

SolidQueue::Cli.start(ARGV)
